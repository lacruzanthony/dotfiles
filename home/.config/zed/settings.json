// Zed — https://zed.dev/docs/configuring-zed
// Gestionado desde ~/.dotfiles/home/.config/zed/settings.json
{
  // --- Seguridad / sesión ---
  // OJO: confía en cualquier carpeta que abras (ejecuta LSPs, tareas y hooks del repo sin preguntar).
  "session": {
    "trust_all_worktrees": true
  },

  // --- Edición ---
  "vim_mode": true,
  "base_keymap": "Zed",
  "tab_size": 2,
  "format_on_save": "on",
  "show_wrap_guides": true,
  "wrap_guides": [80], // printWidth por defecto de Prettier (tus repos no lo cambian)

  // --- Apariencia ---
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_features": { "calt": false, "liga": false }, // sin ligaduras: se ve lo que hay escrito
  "buffer_font_size": 14,
  "ui_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark"
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  // Panel de archivos a la derecha: el código no se desplaza al abrirlo/cerrarlo (como Kent).
  "project_panel": {
    "dock": "right"
  },
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font"
  },

  // --- Extensiones (Zed las instala solo al arrancar) ---
  "auto_install_extensions": {
    "kotlin": true,     // repos Android (para trabajo serio, Android Studio)
    "dockerfile": true,
    "make": true,       // Makefiles de los repos
    "toml": true        // pyproject.toml, config de codex/starship
  },

  // --- Front (React + TS + Vite + ESLint flat config + Prettier) ---
  // Prettier: Zed usa el de node_modules y el .prettierrc de cada repo (formatter "auto").
  // ESLint: aplica sus fixes al guardar; después formatea Prettier.
  "languages": {
    "JavaScript": {
      "code_actions_on_format": { "source.fixAll.eslint": true }
    },
    "TypeScript": {
      "code_actions_on_format": { "source.fixAll.eslint": true }
    },
    "TSX": {
      "code_actions_on_format": { "source.fixAll.eslint": true }
    }
  },

  // --- IA ---
  // Autocompletado inline: Zeta (Zed no soporta Claude como proveedor de predicciones).
  // Tab acepta la predicción. Sin predicciones en archivos sensibles.
  "edit_predictions": {
    "provider": "zed",
    "mode": "eager",
    "disabled_globs": ["**/.env*", "**/*.pem", "**/*.key", "**/secrets/**"]
  },
  // Agente: Claude Code vía ACP (panel del agente).
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },

  "telemetry": {
    "diagnostics": false,
    "metrics": false
  }
}
